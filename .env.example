# Bridge website — launch mode switch.
# waitlist → CTAs become a waitlist signup (default).
# public   → original download/install experience, no other changes needed.
VITE_LAUNCH_MODE=waitlist

# Optional: POST waitlist signups as JSON to this URL as well
# (signups are always kept in browser localStorage, no backend required).
# VITE_WAITLIST_ENDPOINT=https://example.com/api/waitlist
